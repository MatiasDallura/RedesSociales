NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: restrict login to one email in middleware/server code.
NEXT_PUBLIC_ALLOWED_EMAIL=

# AI provider. OPENAI_API_KEY works with OpenAI and OPENAI_BASE_URL supports compatible providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional: real profile discovery through public web search results.
# This does not scrape LinkedIn/Facebook/Instagram pages.
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
